# Paid RPC recommended. Public RPC is rate-limited.
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Optional websocket for event-mode detection. Falls back to HTTP watch / polling.
# RH_WS_URL=wss://rpc.mainnet.chain.robinhood.com
# RH_RPC_TIMEOUT_MS=15000
# RH_RPC_RETRIES=2

# Master / deployer key for the bundler. Never commit this file.
MASTER_PRIVATE_KEY=0x

# Optional factory override if pons migrates the v2 stack.
# PONS_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
# PONS_LAUNCH_AND_BUY=0xe33E9E479dF8802cb0866d5d05258bEc4cF62948

# --- Sniper ---
# Uses SNIPER_PRIVATE_KEY if set, otherwise MASTER_PRIVATE_KEY. One wallet by default.
# SNIPER_PRIVATE_KEY=0x

SNIPER_ENABLED=true
# Dry-run is the default. Live buys also require `sniper run --live`.
SNIPER_DRY_RUN=true

# event (preferred) or polling
SNIPER_DETECTION_MODE=event
SNIPER_POLL_INTERVAL_MS=2000
SNIPER_POLL_LOOKBACK_BLOCKS=4
SNIPER_DATA_DIR=./data/sniper

SNIPER_BUY_AMOUNT=0.02
SNIPER_MAX_SLIPPAGE_BPS=800
SNIPER_GAS_RESERVE=0.0004
SNIPER_MAX_POSITION_SIZE=0.05
SNIPER_MAX_POSITIONS=5
SNIPER_MAX_EXPOSURE=0.2
SNIPER_MAX_TOKEN_EXPOSURE=0.05
SNIPER_MAX_ENTRIES_PER_HOUR=10
SNIPER_COOLDOWN_MS=15000
SNIPER_EXECUTION_COOLDOWN_MS=15000
SNIPER_ONE_POSITION_PER_TOKEN=true

# Public snipers pay a decaying opening tax. 0 waits until currentSnipeTaxBps is 0.
SNIPER_MAX_SNIPE_TAX_BPS=0
SNIPER_MAX_CREATOR_TAX_BPS=500
SNIPER_NATIVE_QUOTE_ONLY=true
SNIPER_MIN_REAL_QUOTE=0
# SNIPER_MAX_REAL_QUOTE=1.0

# Comma-separated 0x addresses / symbols. Empty allowlist means "allow all".
# SNIPER_CREATOR_ALLOWLIST=
# SNIPER_CREATOR_DENYLIST=
# SNIPER_SYMBOL_ALLOWLIST=
# SNIPER_SYMBOL_DENYLIST=
# SNIPER_PAIR_ALLOWLIST=

SNIPER_RECONCILE_INTERVAL_MS=15000
SNIPER_RECEIPT_TIMEOUT_MS=60000
SNIPER_SNIPE_TAX_RETRY_MS=750
SNIPER_SNIPE_TAX_RETRY_WINDOW_MS=8000
